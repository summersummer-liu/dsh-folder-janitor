{
  "name": "dsh-folder-janitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "整理混乱文件夹：只读体检 → 可复核的移动清单 → 带日志的执行 → 一键撤销。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "folders", "tidy", "organize"],
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
