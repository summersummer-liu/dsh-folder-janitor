{
  "name": "dsh-folder-janitor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "整理混乱文件夹的 DSH 插件：只读体检 → 可复核的移动清单 → 带日志执行 → 一键撤销。Tidy a messy folder with a reviewable plan and one-step undo.",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "folders", "tidy", "organize", "undo"],
  "license": "MIT",
  "author": "summersummer-liu",
  "repository": {
    "type": "git",
    "url": "https://github.com/summersummer-liu/dsh-folder-janitor"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg"
  },
  "files": [
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    }
  }
}
